<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.bbtc</groupId>
    <artifactId>bluebird-task</artifactId>
    <version>0.1.0</version>
    <name>bluebird-task</name>
    <description>BlueBird Task 私有化任务管理系统（单制品 jar，SQLite，无缓存）</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <sqlite.version>3.46.1.3</sqlite.version>
        <jjwt.version>0.11.5</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
        <swagger.version>2.2.22</swagger.version>
        <poi.version>5.5.1</poi.version>
        <!-- sqlite-jdbc 原生库裁剪目标。留空 = 由 deploy/slim-sqlite.* 按构建机检测；
             CI 或交叉构建时用 -Dsqlite.platform=linux -Dsqlite.arch=aarch64 显式指定。 -->
        <sqlite.platform></sqlite.platform>
        <sqlite.arch></sqlite.arch>
        <!-- 一次性生成 5 平台 x 2 架构共 10 个包：mvn package -Dsqlite.all=true -->
        <sqlite.all></sqlite.all>
        <!-- 质量工具链（见 build/plugins）：三件套都锁版本，避免 CI 与本地跑出不同结果。 -->
        <jacoco.version>0.8.12</jacoco.version>
        <!-- 覆盖率门禁阈值（防回落用，不是质量目标），可用 -D 覆盖做验证 -->
        <jacoco.line.minimum>0.60</jacoco.line.minimum>
        <jacoco.branch.minimum>0.44</jacoco.branch.minimum>
        <spotbugs.plugin.version>4.8.6.6</spotbugs.plugin.version>
        <pmd.plugin.version>3.25.0</pmd.plugin.version>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
    </properties>

    <!-- 国内网络下 central 常被限速：把阿里云镜像放在仓储列表最前，
         命中不了再回落到 central。插件也要单独声明，否则 quality 插件仍走 central。 -->
    <repositories>
        <repository>
            <id>aliyun-public</id>
            <name>Aliyun Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-public</id>
            <name>Aliyun Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 健康检查：/actuator/health 供 systemd / docker healthcheck 使用。
             application.yml 的 management 配置与 SecurityConfig 白名单均已引用该端点，
             此前缺此依赖导致 /actuator/health 落到 10004（资源不存在）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ORM -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Excel（部门导入/导出/模板，.xlsx）。
             运行时用 common/excel 下的 XlsxReader/XlsxWriter（JDK zip+XML），不打 POI；
             POI 只留在 test 作用域，当「独立实现」的裁判：单测用它读回我们写出的文件、
             用它造文件喂给我们的解析器。这样既不进运行时包，又保留了交叉验证。
             注意：不要改成 compile，会重新把 poi+poi-ooxml+xmlbeans+commons-math3 约 12 MB 塞回 jar。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Flyway（迁移）；SQLite 支持随 flyway-core 提供 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- API 文档：默认**不进**依赖，用 -Papidocs 激活（见文件末尾 profiles）。
             以前是 compile 作用域靠 DOC_ENABLED 运行时关掉，但 swagger-ui + springdoc + swagger-core
             约 4 MB 照样躺在 jar 里；生产包不需要这些静态资源。
             但控制器上的 @Operation / @Tag 是编译期注解，所以单留 annotations-jakarta（约 50 KB），
             这样「默认包不带文档实现」和「注解不丢」两个目标不冲突。 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>bluebird-task</finalName>
        <plugins>
            <!-- 显式开启注解处理：classpath 上有 Lombok / spring-boot-configuration-processor，
                 javac 会「隐式启用」并打印「由于在类路径中发现了一个或多个处理程序…」。
                 JDK 23 起隐式注解处理被取消，届时 Lombok 不再生成 getter/setter，
                 所以这里写成 -proc:full 把它变成显式契约（注意不能用 -proc:none，那会真的关掉
                 Lombok 导致全量编译失败）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- 覆盖率度量（目标见 docs：先量基线，再上只防回落的门禁）。
                 report 绑在 test 阶段：跑完单测即可在 target/site/jacoco/ 看到报告。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- 门禁：只防「回落」，不是质量目标。
                         2026-11 实测基线：行 63.6% / 分支 47.1%（含集成测试，136 用例）。
                         阈值取略低于基线，避免正常重构（比如删掉一段没人用的代码）就把流水线卡住；
                         要往上提的时候先补测试再把数字调上去。 -->
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 静态分析（2/2）：SpotBugs 只看 Medium 以上，High 才允许阻断构建。
                 规则基线见 config/spotbugs-exclude.xml（每条排除都必须写理由）。 -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>High</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>1.13.0</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 静态分析（1/2）：PMD 只跑 curated 规则集（config/pmd-ruleset.xml），
                 不用内置 quickstart，避免一上来几千条噪声把门禁变成摆设。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd.plugin.version}</version>
                <configuration>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>true</failOnViolation>
                    <linkXRef>false</linkXRef>
                    <includeTests>false</includeTests>
                    <!-- 只产 XML：HTML 报表需要 site skin，离线/内网构建会因取不到皮肤而失败 -->
                    <format>xml</format>
                    <rulesets>
                        <ruleset>${project.basedir}/config/pmd-ruleset.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 静态分析（2/2）：Checkstyle 只做「纯格式/书写规范」，
                 与 PMD 的规则集刻意不重叠（见 config/checkstyle.xml 顶部说明）。
                 不扫测试代码：测试里长中文断言与紧凑写法是刻意的。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>${project.basedir}/config/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <linkXRef>false</linkXRef>
                    <inputEncoding>UTF-8</inputEncoding>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 先清空上一次内嵌的前端产物：maven-resources 只做覆盖拷贝，
                 增量构建（不带 clean）会残留旧 hash 的 chunk，导致 jar 里同时存在多份
                 旧前端资源（曾出现 7 个 LoginView-*.js，其中 6 个仍是改品牌前的旧文案）。
                 该执行必须声明在 copy-frontend-dist 之前（同 phase 按声明顺序执行）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-stale-frontend-static</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}/static</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <followSymlinks>false</followSymlinks>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 打包期内嵌前端产物（ADR-009）。frontend/dist 不存在时安全跳过。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 接口文档（springdoc + swagger-ui）默认不激活：生产/单机部署直接用默认构建，jar 里没有这 4 MB。
             本地要看 Swagger UI 时：mvn -Papidocs spring-boot:run（或 -Papidocs package 做临时包）。
             DOC_ENABLED 环境变量仍需为 true，二者是「装不装」与「开不开」两层开关。 -->
        <profile>
            <id>apidocs</id>
            <dependencies>
                <dependency>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                    <version>${springdoc.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <!-- sqlite-jdbc 原生库裁剪：repackage 之后重写嵌套 jar，只保留目标平台目录。
             产物写到 target/dist/bluebird-task-<version>-<platform>-<arch>.jar，
             并建立稳定别名 target/dist/bluebird-task.jar（软链，Windows 用复制）。
             平台/架构不传时由脚本按构建机检测；CI 上若不是 linux/x86_64 会直接失败。 -->
        <profile>
            <id>slim-sqlite-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>slim-sqlite</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="powershell" failonerror="true"
                                              dir="${project.basedir}">
                                            <arg value="-NoProfile"/>
                                            <arg value="-ExecutionPolicy"/>
                                            <arg value="Bypass"/>
                                            <arg value="-File"/>
                                            <arg value="${project.basedir}/../deploy/slim-sqlite.ps1"/>
                                            <env key="SLIM_JAR" value="${project.build.directory}/bluebird-task.jar"/>
                                            <env key="SLIM_VERSION" value="${project.version}"/>
                                            <env key="SLIM_PLATFORM" value="${sqlite.platform}"/>
                                            <env key="SLIM_ARCH" value="${sqlite.arch}"/>
                                            <env key="SLIM_ALL" value="${sqlite.all}"/>
                                            <env key="SLIM_OUT" value="${project.build.directory}/dist"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>slim-sqlite-unix</id>
            <activation>
                <os>
                    <family>unix</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>slim-sqlite</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="/bin/bash" failonerror="true"
                                              dir="${project.basedir}">
                                            <arg value="${project.basedir}/../deploy/slim-sqlite.sh"/>
                                            <env key="SLIM_JAR" value="${project.build.directory}/bluebird-task.jar"/>
                                            <env key="SLIM_VERSION" value="${project.version}"/>
                                            <env key="SLIM_PLATFORM" value="${sqlite.platform}"/>
                                            <env key="SLIM_ARCH" value="${sqlite.arch}"/>
                                            <env key="SLIM_ALL" value="${sqlite.all}"/>
                                            <env key="SLIM_OUT" value="${project.build.directory}/dist"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
