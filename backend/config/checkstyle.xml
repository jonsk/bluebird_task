<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  精简规则集：只放 PMD 覆盖不到的「纯格式/书写规范」，
  与 config/pmd-ruleset.xml 互补，避免同一问题报两遍（那只会让人开始忽略告警）。

  刻意**不**收：
  - UnusedImports / RedundantImport —— PMD 的 codestyle/UnnecessaryImport 已覆盖；
  - JavadocMethod / MissingJavadoc —— 本项目按「能读懂意图的注释」为准，不强制模板化 Javadoc；
  - Indentation —— 与 IDE 格式化冲突，且对 diff 噪音大。

  severity=warning：调用方把 violationSeverity 设为 warning，因此 warning 也会让 verify 失败。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- 制表符：本仓库统一用空格缩进 -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- 行宽：明确上限，避免出现难以 review 的长行（既有的长行保持在上限内） -->
    <module name="LineLength">
        <property name="max" value="200"/>
        <property name="ignorePattern" value="^\s*\*.*$|^import .*$|^package .*$"/>
    </module>

    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">
        <!-- 禁止通配符导入（PMD 不管这个） -->
        <module name="AvoidStarImport"/>

        <!-- 修饰符顺序必须是 public static final，而不是 static public final -->
        <module name="ModifierOrder"/>

        <!-- 一行一条语句 / 一个变量声明 -->
        <module name="OneStatementPerLine"/>

        <!-- long 字面量用大写 L：小写 l 与 1 难区分 -->
        <module name="UpperEll"/>

        <!-- String args[] 写成 String[] args -->
        <module name="ArrayTypeStyle"/>

        <!-- 控制语句必须带花括号：避免「补一行就改变语义」的历史事故。
             allowSingleLineStatement：`if (page < 1) page = 1;` 这类单行卫语句是现有风格，
             一律包成三行只会让分页方法更难看；这里只拦跨行的无括号 if。 -->
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/>
        </module>

        <!-- 空代码块至少要写注释说明为何为空（catch 里刻意忽略必须表态） -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_CATCH,LITERAL_FINALLY,LITERAL_IF,LITERAL_FOR,LITERAL_WHILE,LITERAL_SWITCH"/>
        </module>
    </module>
</module>
