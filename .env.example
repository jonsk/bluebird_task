# 仅占位符，无任何真实密钥（ADR-010：密钥由首次启动自动生成写入 ./.application.yml，
# 不以 .env 留空占位，避免空串覆盖自动生成值架空首 ADMIN 初始化）。
#
# 复制为 .env 并填值仅用于本地开发覆盖；生产走系统环境变量 / file:./application.yml。

# 服务端口
SERVER_PORT=8080

# 数据库（SQLite：嵌入式单文件，无外部服务；默认 ./data/bluebird.db）
SQLITE_URL=jdbc:sqlite:./data/bluebird.db
DB_PATH=./data

# 缓存：无（不引入 Redis/缓存层，ADR-016）

# 认证提供方：LOCAL（默认）| OIDC | WECHAT（ADR-006/ADR-008）
IDENTITY_PROVIDER=LOCAL

# 组织同步：NONE（默认）| SCIM | PULL | PUSH
ORGSYNC_MODE=NONE

# 存储
STORAGE_PATH=/data/bluebird/files

# 文档（生产关闭，防接口信息暴露，ADR-011）
DOC_ENABLED=false
