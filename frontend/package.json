{
  "name": "bluebird-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BlueBird Task 前端（Vue 3 + TS + Vite + Element Plus + Tailwind）",
  "scripts": {
    "dev": "vite",
    "gen:types": "openapi-typescript ../docs/api/openapi.yaml -o src/types/api.d.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm gen:types && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "lint": "eslint . --ext .ts,.vue --max-warnings 0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "cropperjs": "1.6.3",
    "echarts": "6.1.0",
    "element-plus": "^2.8.4",
    "highlight.js": "^11.12.0",
    "katex": "0.18.5",
    "md-editor-v3": "^7.1.0",
    "mermaid": "11.17.2",
    "pinia": "^2.2.4",
    "prettier": "3.9.6",
    "screenfull": "5.2.0",
    "vue": "^3.5.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "msw": "^2.4.9",
    "openapi-typescript": "^7.4.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vue-tsc": "^2.1.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4"
}
