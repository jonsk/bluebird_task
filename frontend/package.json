{
  "name": "bluebird-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BlueBird Task 前端（Vue 3 + TS + Vite + Element Plus + Tailwind）",
  "scripts": {
    "dev": "vite",
    "gen:types": "openapi-typescript ../docs/api/openapi.yaml -o src/types/api.d.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm gen:types && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-color": "^3.33.1",
    "@tiptap/extension-details": "^3.33.1",
    "@tiptap/extension-drag-handle-vue-3": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-mention": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-table-of-contents": "^3.33.1",
    "@tiptap/extension-task-item": "^3.33.1",
    "@tiptap/extension-task-list": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "@tiptap/vue-3": "^3.33.1",
    "axios": "^1.7.7",
    "element-plus": "^2.8.4",
    "marked": "^15.0.12",
    "pinia": "^2.2.4",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "msw": "^2.4.9",
    "openapi-typescript": "^7.4.1",
    "postcss": "^8.4.47",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vue-tsc": "^2.1.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4"
}
