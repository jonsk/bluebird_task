# ---- 环境/密钥（绝不入库，修订 B4）----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
application-local.yml
secrets/

# ---- 本地数据库 / 缓存 ----
*.db
*.sqlite
*.sqlite3
dump.rdb
*.rdb

# ---- 日志 ----
*.log
logs/
*.log.*

# ---- 构建产物 ----
target/
build/
out/
dist/
*.jar
*.war
*.class

# ---- 前端 ----
node_modules/
frontend/dist/
# 构建前临时改名的旧产物（沙箱下无法原地清空 dist 时的绕行做法）
frontend/dist-old-*/
*.tsbuildinfo
coverage/
# Playwright 运行产物（截图 / trace / video；--output 指定的临时目录也要挡）
frontend/test-results*/
playwright-report/
frontend/playwright-report/

# ---- 脚本工具（不入库）----
# 验收矩阵、黄金截图、契约检查等本地工具脚本
scripts/

# ---- 前端基线文档（不入库）----
# 组件契约、fixtures、截图占位等；体积大且频繁变动，不入库
docs/frontend-baseline/

# ---- 后端内嵌前端产物目录（ADR-009，构建期注入）----
backend/src/main/resources/static/

# ---- WorkBuddy 会话数据（不入库）----
.workbuddy/

# ---- IDE / 系统 ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- 临时 ----
*.tmp
*.swp
*~
.TEMP/

# ---- gitleaks 报告（只留基线，报告不入库）----
gitleaks-report.*

# runtime-released config & local data (ADR-010/016)
/backend/application.yml
/backend/data/
data/
# ---- 部署产物（deploy/package.sh 输出）----
deploy/out/
