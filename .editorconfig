# EditorConfig — 统一缩进/换行/编码（跨 IDE）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,yaml,yml,md,json,sql}]
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{ts,tsx,vue,js,jsx,scss,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
